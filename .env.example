# SQLite is ready immediately. For MySQL, use only your dedicated trialdelta schema.
DATABASE_URL=sqlite:///./data/trialdelta.db
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/trialdelta?charset=utf8mb4
APP_MODE=local
APP_ORIGIN=http://127.0.0.1:8765
# Set hosted mode, HTTPS origin, and strong bootstrap credentials before public hosting.
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_SECURE=false
SYNC_INTERVAL_HOURS=24
# Optional local workstation convention, using existing DATABASE_PASSWORD environment:
USE_LOCAL_MYSQL=false
MYSQL_USER=root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Optional read-only news source connection (MySQL):
SOURCE_DATABASE_URL=
# Optional daily email delivery; disabled by default. See README before enabling.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
