# SQLite is ready immediately. For MySQL, use only your dedicated trialdelta schema.
DATABASE_URL=sqlite:///./data/trialdelta.db
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/trialdelta?charset=utf8mb4
APP_MODE=local
AUTH_REQUIRED=true
# Anonymous research reads only; personal actions always require an account.
PUBLIC_BROWSING_ENABLED=true
REGISTRATION_ENABLED=true
APP_ORIGIN=http://127.0.0.1:8765
# Set hosted mode, HTTPS origin, and strong bootstrap credentials before public hosting.
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_SECURE=false
SYNC_INTERVAL_HOURS=24
# Optional local workstation convention, using the existing gptdb password environment variable:
USE_LOCAL_MYSQL=false
MYSQL_USER=gptdb
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Read-only market coverage, news, and filings source connection (MySQL).
# Coverage refresh requires SELECT on stocks.symbol_sector_industry.
# If blank, coverage uses the configured TrialDelta MySQL connection when available.
SOURCE_DATABASE_URL=
# Externally maintained ticker-to-company-name JSON dictionary.
# Required for new names during manual bulk and worker coverage refreshes.
# Default matches Healthcare_Data/utilities.py; override on another host.
# HEALTHCARE_COMPANY_NAMES_PATH=E:\Market Research\Dataset\Fundamental Data\company_names.txt
# SMTP enables account verification and password recovery.
# Daily digests also require opt-in and the worker --send-email option.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
