DOMAIN=trialdelta.example.com
APP_ORIGIN=https://trialdelta.example.com
APP_MODE=hosted
AUTH_REQUIRED=true
# Anonymous research reads only; personal actions always require an account.
PUBLIC_BROWSING_ENABLED=false
REGISTRATION_ENABLED=true
COOKIE_SECURE=true
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_14_CHARACTERS
DATABASE_URL=sqlite:////app/data/trialdelta.db
# Optional RDS MySQL (the database must be named trialdelta):
# DATABASE_URL=mysql+pymysql://USER:URL_ENCODED_PASSWORD@RDS_HOST:3306/trialdelta?charset=utf8mb4&ssl_ca=/app/certs/global-bundle.pem&ssl_verify_cert=true&ssl_verify_identity=true
SYNC_INTERVAL_HOURS=24
# Read-only market source; grant SELECT on stocks.symbol_sector_industry.
# Supply a reachable MySQL source and mount the externally maintained name file.
SOURCE_DATABASE_URL=
# SOURCE_DATABASE_URL=mysql+pymysql://READ_USER:URL_ENCODED_PASSWORD@SOURCE_HOST:3306/stocks?charset=utf8mb4
# HEALTHCARE_COMPANY_NAMES_PATH=/app/reference/company_names.txt
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
